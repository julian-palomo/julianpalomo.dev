{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "julianpalomo-dev",
  "compatibility_date": "2026-10-23",
  // enable_request_signal makes request.signal fire when a visitor presses
  // Stop or leaves, so /api/chat cancels the model call instead of paying for
  // an answer nobody reads. Without it the signal never fires in Workers.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [{ "pattern": "julianpalomo.dev", "custom_domain": true }],
  // Preview URLs are served from workers.dev, so both stay on. Set explicitly
  // because their defaults differ between wrangler's schema and Cloudflare's docs.
  "workers_dev": true,
  "preview_urls": true,
  // Previews have no API key, so the chat answers in demo mode there. Never set
  // BOT_DEMO at the top level: production has a key and ignores it anyway.
  // CONTACT_DEMO makes the contact form use Turnstile's test keys and send
  // nothing (src/lib/contact/send.ts), so only production emails Julian. Never
  // set it at the top level: production would drop every message.
  "previews": {
    "vars": { "BOT_DEMO": "1", "SCENE_OVERRIDE": "1", "CONTACT_DEMO": "1" }
  },
  // Only for the e2e build (CLOUDFLARE_ENV=e2e in playwright.config.ts), never
  // deployed. An empty `secrets.required` keeps the Vite plugin from copying a
  // local .dev.vars, with a real key, into the build, so e2e runs stay in demo
  // mode and never call the model.
  "env": {
    "e2e": {
      // Empty so this environment never inherits, and never takes over, the
      // production custom domain.
      "routes": [],
      "vars": { "BOT_DEMO": "1", "SCENE_OVERRIDE": "1", "CONTACT_DEMO": "1" },
      "secrets": { "required": [] }
    }
  },
  // The chat's daily limits (src/lib/bot/usage.ts). Not repeated under
  // `previews` or `env.e2e`: there the endpoint has no key, answers in demo
  // mode or "not available", and never touches D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "julianpalomo-dev",
      "database_id": "da5589f3-a532-476f-a821-b8a86e4153bf"
    }
  ],
  // The contact form's email to Julian (src/lib/contact/send.ts). No
  // destination here: the binding may send to any verified Email Routing
  // address, and the address comes from the CONTACT_TO secret, so it never
  // appears in the repo. Not repeated under `env.e2e`, which sends nothing.
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true
  }
}
