# Workers serves static assets with "max-age=0, must-revalidate", so a browser
# asks again for every file on every page load. Files in /assets/ carry a hash
# of their content in their name, so they never change under the same name:
# cache them for a year. Never widen this to files that keep their name when
# they change (the CV, the sound sprite, the images, the icons).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
