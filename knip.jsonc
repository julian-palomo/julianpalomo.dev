{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // `pnpm sounds` runs ffmpeg, a local tool rather than a package: the npm
  // packages that bundle it are GPL or LGPL (docs/sounds.md).
  "ignoreBinaries": ["ffmpeg"],
  // The share images' card page, which scripts/og/index.html loads.
  "entry": ["scripts/og/main.tsx"]
}
